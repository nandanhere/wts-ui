{
  "name": "wts-ui",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:docs": "node scripts/lint-docs.mjs",
    "lint:ui-copy": "node scripts/lint-ui-copy.mjs",
    "audit:public": "node scripts/check-open-source-readiness.mjs",
    "test:docs": "node --test scripts/lint-docs.test.mjs",
    "test:public-audit": "node --test scripts/check-open-source-readiness.test.mjs",
    "test": "node scripts/run-node-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:selfhost": "npm --prefix ui run test:e2e:selfhost",
    "test:browser-driver": "node --test scripts/wts-browser-driver.test.mjs",
    "test:browser-driver:install": "playwright install chromium",
    "desktop:dev": "bash scripts/prepare-desktop-dev.sh && tauri dev",
    "test:desktop-dev-helper": "node --test scripts/prepare-desktop-dev.test.mjs",
    "build:macos:qa": "bash scripts/build-macos-app.sh",
    "install:macos:qa": "npm run build:macos:qa && node scripts/install-macos-app.mjs",
    "test:macos-installer": "node --test scripts/install-macos-app.test.mjs",
    "test:macos-updater": "node --test scripts/stage-macos-update.test.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.3",
    "@astryxdesign/theme-neutral": "^0.1.3",
    "clsx": "2.1.1",
    "js-yaml": "^5.2.1",
    "lucide-react": "1.26.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "2.11.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
