{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WTS",
  "version": "0.1.0",
  "identifier": "dev.wts.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev -- --host 127.0.0.1 --port 1420",
      "cwd": "../ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "WTS · Local Workspace Supervisor",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ],
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "base-uri": "'none'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self' http://127.0.0.1:1420",
        "base-uri": "'none'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420",
        "font-src": "'self' data:",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "img-src": "'self' blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "dangerousInsecureTransportProtocol": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/icon.png"
    ],
    "shortDescription": "Issue-scoped worktree and development session manager",
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.0"
    }
  }
}
