{
  "schemaVersion": 1,
  "id": "orders-api",
  "description": "The local checkout API service used by the browser journey.",
  "ports": [
    {
      "id": "api",
      "environment": "ORDERS_API_PORT",
      "offset": 0
    }
  ],
  "processes": [
    {
      "id": "orders-api",
      "workingDirectory": ".",
      "executable": "cargo",
      "arguments": ["run"],
      "dependencies": [],
      "health": {
        "port": "api",
        "path": "/health"
      }
    }
  ],
  "smoke": {
    "workingDirectory": ".",
    "executable": "cargo",
    "arguments": ["test"]
  }
}
